#!/bin/sh

# Read-only Bluetooth bring-up report for the RG35XX H compatibility seed.
# This script deliberately does not attach a UART, change rfkill state, load a
# module, start discovery, or expose a Bluetooth hardware address.

set -u

redact_addresses()
{
    sed 's/[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]/<bluetooth-address>/g'
}

section()
{
    printf '\n-- %s --\n' "$1"
}

printf 'GuideOS Bluetooth probe 0\n'
printf 'This report made no radio or storage changes.\n'

section 'system'
printf 'kernel: '
uname -r 2>/dev/null || printf 'unknown\n'
printf 'machine: '
uname -m 2>/dev/null || printf 'unknown\n'

section 'UART candidate'
if [ -e /dev/ttyS1 ]; then
    ls -l /dev/ttyS1 2>/dev/null || printf '/dev/ttyS1 exists\n'
else
    printf '/dev/ttyS1 missing\n'
fi

section 'Bluetooth adapters'
if [ -d /sys/class/bluetooth ]; then
    found_adapter=0
    for adapter in /sys/class/bluetooth/hci*; do
        [ -e "$adapter" ] || continue
        found_adapter=1
        printf '%s\n' "$(basename "$adapter")"
    done
    [ "$found_adapter" -eq 1 ] || printf 'no hci adapter present\n'
else
    printf 'Bluetooth class unavailable\n'
fi

section 'radio switches'
found_switch=0
for radio in /sys/class/rfkill/rfkill*; do
    [ -d "$radio" ] || continue
    found_switch=1
    printf '%s' "$(basename "$radio")"
    for field in name type state soft hard; do
        if [ -r "$radio/$field" ]; then
            value=$(cat "$radio/$field" 2>/dev/null || printf '?')
            printf ' %s=%s' "$field" "$value"
        fi
    done
    printf '\n'
done
[ "$found_switch" -eq 1 ] || printf 'no rfkill entries present\n'

section 'relevant loaded modules'
if [ -r /proc/modules ]; then
    grep -Ei '(^|_)(bluetooth|bt|hci|rfkill|8821|rtw)' /proc/modules 2>/dev/null || printf 'none matched\n'
else
    printf '/proc/modules unavailable\n'
fi

section 'firmware candidates'
found_firmware=0
for firmware in \
    /lib/firmware/rtl_bt/rtl8821c_fw.bin \
    /lib/firmware/rtl_bt/rtl8821c_config.bin \
    /lib/firmware/rtl_bt/rtl8821cs_fw.bin; do
    if [ -r "$firmware" ]; then
        found_firmware=1
        size=$(wc -c < "$firmware" 2>/dev/null || printf '?')
        printf '%s bytes=%s\n' "$firmware" "$size"
    fi
done
[ "$found_firmware" -eq 1 ] || printf 'no expected RTL8821C/CS files present\n'

section 'bounded kernel messages'
if command -v dmesg >/dev/null 2>&1; then
    dmesg 2>/dev/null \
        | grep -Ei 'bluetooth|(^|[^[:alnum:]])bt([^[:alnum:]]|$)|hci|rfkill|ttyS1|uart1|8821|realtek' \
        | tail -n 120 \
        | redact_addresses
else
    printf 'dmesg unavailable\n'
fi

printf '\nEnd of read-only probe.\n'
