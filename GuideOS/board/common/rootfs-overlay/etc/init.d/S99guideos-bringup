#!/bin/sh

case "$1" in
    start)
        if [ -w /dev/tty0 ]; then
            printf '\033[2J\033[H' > /dev/tty0
            printf 'GUIDEOS BRINGUP-0\n\n' > /dev/tty0
            printf 'The Deck has reached userspace.\n' > /dev/tty0
            printf 'No storage media was modified during image creation.\n\n' > /dev/tty0
            printf 'Kernel: ' > /dev/tty0
            uname -r > /dev/tty0
            printf '\nUse the controls to verify input after login.\n' > /dev/tty0
        fi
        ;;
esac

exit 0
