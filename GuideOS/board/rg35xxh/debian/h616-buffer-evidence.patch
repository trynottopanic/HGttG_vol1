+static int sun50i_h616_probe_get(struct snd_kcontrol *control,
+				struct snd_ctl_elem_value *value)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(control);
+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(component->card);
+
+	value->value.integer.value[0] = READ_ONCE(scodec->probe_armed);
+	return 0;
+}
+
+static int sun50i_h616_probe_put(struct snd_kcontrol *control,
+				struct snd_ctl_elem_value *value)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(control);
+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(component->card);
+	unsigned long flags;
+	long armed = value->value.integer.value[0];
+
+	if (armed != 0 && armed != 1)
+		return -EINVAL;
+	spin_lock_irqsave(&scodec->probe_lock, flags);
+	scodec->probe_armed = armed;
+	if (armed)
+		memset(scodec->probe_values, 0, sizeof(scodec->probe_values));
+	spin_unlock_irqrestore(&scodec->probe_lock, flags);
+	return 1;
+}
+
+static int sun50i_h616_probe_info(struct snd_kcontrol *control,
+				 struct snd_ctl_elem_info *info)
+{
+	info->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	info->count = 11;
+	info->value.integer.min = 0;
+	info->value.integer.max = 0x7fffffff;
+	return 0;
+}
+
+static int sun50i_h616_probe_values(struct snd_kcontrol *control,
+				   struct snd_ctl_elem_value *value)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(control);
+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(component->card);
+	unsigned long flags;
+	int i;
+
+	spin_lock_irqsave(&scodec->probe_lock, flags);
+	for (i = 0; i < ARRAY_SIZE(scodec->probe_values); i++)
+		value->value.integer.value[i] = scodec->probe_values[i];
+	spin_unlock_irqrestore(&scodec->probe_lock, flags);
+	return 0;
+}
