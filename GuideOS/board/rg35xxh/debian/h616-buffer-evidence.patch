+/* Owner-armed, one-shot aggregate of the first 4096 DMA-buffer bytes. */
+static void sun50i_h616_probe_buffer(struct sun4i_codec *scodec,
+				    struct snd_pcm_substream *substream)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	unsigned long flags;
+	u32 hash = 2166136261U, count = 0, size, i;
+	u8 value;
+
+	spin_lock_irqsave(&scodec->probe_lock, flags);
+	if (!scodec->probe_armed) {
+		spin_unlock_irqrestore(&scodec->probe_lock, flags);
+		return;
+	}
+	scodec->probe_armed = false;
+	if (!runtime->dma_area || !runtime->dma_bytes) {
+		spin_unlock_irqrestore(&scodec->probe_lock, flags);
+		return;
+	}
+	size = min_t(size_t, runtime->dma_bytes, 4096);
+	for (i = 0; i < size; i++) {
+		value = READ_ONCE(runtime->dma_area[i]);
+		count += value != 0;
+		hash = (hash ^ value) * 16777619U;
+	}
+	scodec->probe_values[0] = 1;
+	scodec->probe_values[1] = size;
+	scodec->probe_values[2] = count;
+	scodec->probe_values[3] = hash & 0xffff;
+	scodec->probe_values[4] = hash >> 16;
+	scodec->probe_values[5] = runtime->sample_bits;
+	scodec->probe_values[6] = runtime->channels;
+	scodec->probe_values[7] = scodec->playback_dma_data.addr;
+	scodec->probe_values[8] = runtime->rate;
+	scodec->probe_values[9] = runtime->dma_bytes;
+	scodec->probe_values[10] = scodec->playback_dma_data.addr_width;
+	spin_unlock_irqrestore(&scodec->probe_lock, flags);
+}
