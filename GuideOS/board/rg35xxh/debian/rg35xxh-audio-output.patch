+/* Exact vendor table, index 5: 138 ms (44.1k family), 126 ms (48k).
+ * Mainline's module-clock accounting reports half the vendor rate.
+ * This changes no clock, FIFO or DMA programming.
+ */
+static int rg35xxh_ramp_delay(unsigned long rate)
+{
+	switch (rate) {
+	case 22579200:
+		return 138;
+	case 24576000:
+		return 126;
+	default:
+		return -EINVAL;
+	}
 }
 
 static int sun50i_h616_codec_ramp_event(struct snd_soc_dapm_widget *w,
 				      struct snd_kcontrol *kcontrol, int event)
 {
 	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
