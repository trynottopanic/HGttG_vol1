+/* RG35XX H line-out requests are applied only after the analog ramp. */
+static int rg35xxh_lineout_get(struct snd_kcontrol *control,
+			     struct snd_ctl_elem_value *value)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(control);
+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(component->card);
+
+	if (!of_machine_is_compatible("anbernic,rg35xx-h"))
+		return snd_soc_get_volsw(control, value);
+	mutex_lock(&scodec->lineout_lock);
+	value->value.integer.value[0] = !!(scodec->lineout_requested &
+					 BIT(SUN50I_H616_LINEOUTL_EN));
+	value->value.integer.value[1] = !!(scodec->lineout_requested &
+					 BIT(SUN50I_H616_LINEOUTR_EN));
+	mutex_unlock(&scodec->lineout_lock);
+	return 0;
+}
+
+static int rg35xxh_lineout_put(struct snd_kcontrol *control,
+			     struct snd_ctl_elem_value *value)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(control);
+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(component->card);
+	unsigned int mask = BIT(SUN50I_H616_LINEOUTL_EN) |
+			    BIT(SUN50I_H616_LINEOUTR_EN);
+	unsigned int requested;
+	int ret, changed;
+
+	if (!of_machine_is_compatible("anbernic,rg35xx-h"))
+		return snd_soc_put_volsw(control, value);
+	if (value->value.integer.value[0] < 0 ||
+	    value->value.integer.value[0] > 1 ||
+	    value->value.integer.value[1] < 0 ||
+	    value->value.integer.value[1] > 1)
+		return -EINVAL;
+	requested = (value->value.integer.value[0] ?
+		     BIT(SUN50I_H616_LINEOUTL_EN) : 0) |
+		    (value->value.integer.value[1] ?
+		     BIT(SUN50I_H616_LINEOUTR_EN) : 0);
+	mutex_lock(&scodec->lineout_lock);
+	changed = requested != scodec->lineout_requested;
+	ret = snd_soc_component_update_bits(component,
+			SUN50I_H616_DAC_AC_DAC_REG, mask,
+			scodec->lineout_ready ? requested : 0);
+	if (ret >= 0)
+		scodec->lineout_requested = requested;
+	mutex_unlock(&scodec->lineout_lock);
+	return ret < 0 ? ret : changed;
+}
