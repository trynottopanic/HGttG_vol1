+	struct sun4i_codec *scodec = snd_soc_card_get_drvdata(component->card);
+	unsigned int mask = BIT(SUN50I_H616_LINEOUTL_EN) |
+			    BIT(SUN50I_H616_LINEOUTR_EN);
+	int delay, ret = 0;
+
+	if (!of_machine_is_compatible("anbernic,rg35xx-h")) {
+		if (event == SND_SOC_DAPM_PRE_PMU)
+			return sun50i_h616_codec_analog_init(component);
+		if (event != SND_SOC_DAPM_PRE_PMD)
+			msleep(25);
+		return 0;
+	}
+
+	mutex_lock(&scodec->lineout_lock);
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		scodec->lineout_ready = false;
+		ret = snd_soc_component_update_bits(component,
+				SUN50I_H616_DAC_AC_DAC_REG, mask, 0);
+		if (ret < 0)
+			break;
+		ret = rg35xxh_ramp_delay(clk_get_rate(scodec->clk_module));
+		if (ret < 0)
+			break;
+		ret = sun50i_h616_codec_analog_init(component);
+		break;
+	case SND_SOC_DAPM_POST_PMU:
+		delay = rg35xxh_ramp_delay(clk_get_rate(scodec->clk_module));
+		if (delay < 0) {
+			ret = delay;
+			break;
+		}
+		msleep(delay);
+		ret = snd_soc_component_update_bits(component,
+				SUN50I_H616_DAC_AC_DAC_REG, mask,
+				scodec->lineout_requested);
+		scodec->lineout_ready = ret >= 0;
+		break;
+	case SND_SOC_DAPM_PRE_PMD:
+		/* Vendor order: ramp down, settle, then disable line-out. */
+		scodec->lineout_ready = false;
+		ret = snd_soc_component_update_bits(component,
+				SUN50I_H616_DAC_AC_RAMP_REG,
+				BIT(SUN50I_H616_RDEN), 0);
+		delay = rg35xxh_ramp_delay(clk_get_rate(scodec->clk_module));
+		msleep(delay < 0 ? 138 : delay);
+		if (ret >= 0)
+			ret = snd_soc_component_update_bits(component,
+					SUN50I_H616_DAC_AC_DAC_REG, mask, 0);
+		else
+			snd_soc_component_update_bits(component,
+					SUN50I_H616_DAC_AC_DAC_REG, mask, 0);
+		break;
+	}
+	mutex_unlock(&scodec->lineout_lock);
+	return ret < 0 ? ret : 0;
