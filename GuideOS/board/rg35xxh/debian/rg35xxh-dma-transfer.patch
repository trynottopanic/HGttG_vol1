 MODULE_DEVICE_TABLE(of, sun4i_codec_of_match);
 
+/* Experimental RG35XX H transfer profile, isolated from other boards. */
+static int rg35xxh_prepare_slave_config(struct snd_pcm_substream *substream,
+				       struct snd_pcm_hw_params *params,
+				       struct dma_slave_config *config)
+{
+	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	int ret;
+
+	ret = snd_dmaengine_pcm_prepare_slave_config(substream, params, config);
+	if (ret || substream->stream != SNDRV_PCM_STREAM_PLAYBACK)
+		return ret;
+
+	config->src_addr_width = config->dst_addr_width;
+	config->src_maxburst = 4;
+	config->dst_maxburst = 4;
+	dev_info(rtd->dev,
+		 "GuideOS audio-path-9 DMA: src_width=%u dst_width=%u src_burst=%u dst_burst=%u dst=%pad\n",
+		 config->src_addr_width, config->dst_addr_width,
+		 config->src_maxburst, config->dst_maxburst, &config->dst_addr);
+
+	return 0;
+}
+
+static const struct snd_dmaengine_pcm_config rg35xxh_pcm_config = {
+	.prepare_slave_config = rg35xxh_prepare_slave_config,
+};
