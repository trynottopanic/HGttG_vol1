#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later

case "$1" in
    start)
        if [ ! -d /sys/kernel/config/usb_gadget ]; then
            mount -t configfs configfs /sys/kernel/config
        fi
        gadget=/sys/kernel/config/usb_gadget/guide
        mkdir -p "$gadget"
        printf '0x1d6b' > "$gadget/idVendor"
        printf '0x0104' > "$gadget/idProduct"
        mkdir -p "$gadget/strings/0x409"
        printf 'GuideOS prototype' > "$gadget/strings/0x409/manufacturer"
        printf 'Guide Deck USB link' > "$gadget/strings/0x409/product"
        printf 'GUIDE-PROTOTYPE-0001' > "$gadget/strings/0x409/serialnumber"
        mkdir -p "$gadget/configs/c.1/strings/0x409"
        printf 'Private Node-to-Deck link' > "$gadget/configs/c.1/strings/0x409/configuration"
        mkdir -p "$gadget/functions/rndis.usb0"
        ln -s "$gadget/functions/rndis.usb0" "$gadget/configs/c.1/rndis.usb0" 2>/dev/null || true
        mkdir -p "$gadget/os_desc"
        printf '1' > "$gadget/os_desc/use"
        printf '0xcd' > "$gadget/os_desc/b_vendor_code"
        printf 'MSFT100' > "$gadget/os_desc/qw_sign"
        ln -s "$gadget/configs/c.1" "$gadget/os_desc/c.1" 2>/dev/null || true
        udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
        if [ -n "$udc" ]; then
            printf '%s' "$udc" > "$gadget/UDC"
            i=0
            while [ ! -e /sys/class/net/usb0 ] && [ "$i" -lt 20 ]; do
                sleep 0.1
                i=$((i + 1))
            done
            ip address replace 192.168.77.2/24 dev usb0
            ip link set usb0 up
        fi
        ;;
esac

exit 0
