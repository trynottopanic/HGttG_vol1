# Transitional userspace for the known-working RG35XX H vendor kernel.
# This intentionally builds no kernel or bootloader and contains no vendor
# binary. Private bring-up tooling combines the result with a user-owned boot
# reference; distributable GuideOS images must return to the open boot chain.
BR2_aarch64=y
BR2_ARM_FPU_VFPV4=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TARGET_GENERIC_HOSTNAME="guide-deck"
BR2_TARGET_GENERIC_ISSUE="GuideOS VENDOR-BRIDGE-0"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_GUIDE_OS_PATH)/board/common/rootfs-overlay $(BR2_EXTERNAL_GUIDE_OS_PATH)/board/rg35xxh/prototype-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_GUIDE_OS_PATH)/board/rg35xxh/post-build.sh $(BR2_EXTERNAL_GUIDE_OS_PATH)/board/rg35xxh/post-build-vendor-bridge.sh"
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
BR2_TARGET_ROOTFS_EXT2_MKFS_OPTIONS="-O ^64bit,^orphan_file,^metadata_csum_seed"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_MPV=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_GUIDE_HELLO_FB=y
