[Unit]
Description=Finish an explicitly requested Guide release independently of SSH
After=guide-deploy.service
OnFailure=guide-deploy-rescue.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/guideos/deploy/deploy_server.py apply
TimeoutStartSec=720
Nice=10
MemoryMax=96M
TasksMax=16
Environment=PYTHONDONTWRITEBYTECODE=1
