[Unit]
Description=Paired PC access to Guide deployment only
After=network.target guide-deploy.service
Wants=guide-deploy.service

[Service]
ExecStartPre=/usr/bin/install -d -m0755 /run/sshd
ExecStartPre=/usr/sbin/sshd -t -f /etc/guideos/deploy/sshd_config
ExecStart=/usr/sbin/sshd -D -e -f /etc/guideos/deploy/sshd_config
Restart=on-failure
RestartSec=3
KillMode=process
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=multi-user.target
