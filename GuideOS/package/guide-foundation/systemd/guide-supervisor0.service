[Unit]
Description=Guide application lifecycle supervisor foundation
After=dbus.service
Wants=dbus.service
Requires=guide-supervisor0.socket

[Service]
Type=exec
ExecStart=/usr/libexec/guideos/guide-supervisor0
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
UMask=0077
ReadWritePaths=/run/guideos/supervisor /var/lib/guideos/supervisor
StateDirectory=guideos/supervisor
TasksMax=16
MemoryHigh=12M
MemoryMax=24M

[Install]
WantedBy=multi-user.target
