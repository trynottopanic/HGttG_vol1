[Unit]
Description=Guide memory headroom and application recovery
After=local-fs.target
Before=guide-browser.service
Wants=guide-zram.service
After=guide-zram.service

[Service]
Type=exec
ExecStart=/usr/bin/python3 /usr/lib/guideos/resources/resource_guard.py
RuntimeDirectory=guideos-resources
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=1
TimeoutStopSec=3
CPUWeight=1000
MemoryMin=8M
MemoryLow=16M
MemoryHigh=24M
MemoryMax=32M
TasksMax=16
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/guideos-resources
ReadWritePaths=-/sys/fs/cgroup/user.slice
ReadWritePaths=-/sys/fs/cgroup/system.slice/guide-browser.service
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
