config BR2_PACKAGE_GUIDE_WIKIPEDIA_CORE
	bool "guide-wikipedia-core"
	depends on BR2_PACKAGE_PYTHON3
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_PYTHON3_SSL
	select BR2_PACKAGE_CA_CERTIFICATES
	select BR2_PACKAGE_NETSURF
	select BR2_PACKAGE_NETSURF_SDL
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_WEBP
	help
	  Guide Wikipedia data, offline-storage, and constrained NetSurf view.
	  Wikipedia HTML is reduced to a passive allow-list before rendering;
	  remote scripts and arbitrary web navigation are not enabled.
